{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.1",
  "minimum_chrome_version": "88",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "system.cpu",
    "system.memory",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
